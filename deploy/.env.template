# Template for the stack's `.env` on the VM, which bootstrap.sh creates from it
# and which only the deploy user can read. Never commit the filled-in file.
# Locally no `.env` is needed here: compose.yaml falls back to the defaults.

# The host port nginx publishes. 80 on the VM, if the lab checklist in
# docs/docs/deployment.md finds it reachable; the local default is 8080.
HTTP_PORT=80

# The API image to run: `recommenditos-api:<tag>`, the tag being the short commit
# SHA the image was built from. Rolling back is putting the previous tag here and
# running `docker compose up -d --wait` again.
API_IMAGE_TAG=

# The key POST /v1/feedback requires in X-API-Key (FR-10); at least 16
# characters. The replay job sends it from inside the Compose network; nginx
# refuses /feedback from outside. Generate one on the VM with
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit it (NFR-15). Left empty, /v1/feedback refuses every request.
RECOMMENDITOS_API_KEY=

# The number of uvicorn worker processes of the API. 1 until the load test on
# the VM shows that more are needed (docs/docs/load-testing.md); each costs the
# memory of one more copy of the model.
WEB_CONCURRENCY=1
