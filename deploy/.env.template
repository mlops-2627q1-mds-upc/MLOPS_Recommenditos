# Template for the stack's `.env` on the VM, which bootstrap.sh creates from it
# and which only the deploy user can read. Never commit the filled-in file.
# Locally no `.env` is needed here: compose.yaml falls back to the defaults.

# The host port nginx publishes. 80 on the VM, if the lab checklist in
# docs/docs/deployment.md finds it reachable; the local default is 8080.
HTTP_PORT=80

# The API image to run: `recommenditos-api:<tag>`, the tag being the short commit
# SHA the image was built from. Rolling back is putting the previous tag here and
# running `docker compose up -d --wait` again.
API_IMAGE_TAG=
