    {
      "id": 3,
      "type": "stat",
      "title": "Real MdAPE",
      "description": "The latest tested window's median absolute percentage error over its answers with an observed price (FR-14), the alert's ceiling, a multiple of the test MdAPE that falls as the labelled answers grow (recorded by the alert rules), and the test MdAPE (metrics.json). No value: fewer than 200 labelled answers. Alert: ModelErrorHigh.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "recommenditos_performance_mdape",
          "legendFormat": "window",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "recommenditos_performance:mdape_ceiling_multiple * recommenditos_performance_test_mdape and ignoring(figure) recommenditos_performance_labels_sufficient{figure=\"mdape\"} == 1",
          "legendFormat": "alert above",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "recommenditos_performance_test_mdape",
          "legendFormat": "test",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "no value",
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "alert above"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "test"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "wideLayout": true,
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 14,
          "valueSize": 24
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Range coverage",
      "description": "The share of the latest tested window's labelled price ranges that hold the observed price (FR-14), the alert's floor (the nominal level less a margin that falls as the labelled ranges grow, recorded by the alert rules), and the nominal level the ranges promise. No value: fewer than 300 labelled ranges. Alert: ModelCoverageLow.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "recommenditos_performance_coverage",
          "legendFormat": "window",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "recommenditos_performance:coverage_floor and ignoring(figure) recommenditos_performance_labels_sufficient{figure=\"coverage\"} == 1",
          "legendFormat": "alert below",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "recommenditos_performance_nominal_level",
          "legendFormat": "nominal",
          "refId": "C",
          "instant": true,
          "range": false
